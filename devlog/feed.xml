---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.devlog.name | xml_escape }}</title>
  <subtitle>{{ site.devlog.tagline | xml_escape }}</subtitle>
  <link rel="self" type="application/atom+xml" href="{{ '/devlog/feed.xml' | absolute_url }}" />
  <link rel="alternate" type="text/html" href="{{ '/devlog/' | absolute_url }}" />
  <id>{{ '/devlog/' | absolute_url }}</id>
  <updated>{% if site.posts.size > 0 %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.devlog.author | xml_escape }}</name><uri>{{ '/' | absolute_url }}</uri></author>
  <icon>{{ '/assets/devlog/paw.svg' | absolute_url }}</icon>
  {%- for post in site.posts limit: 20 %}
  {%- assign abs = 'src="' | append: site.url | append: '/' -%}
  {%- assign abs_href = 'href="' | append: site.url | append: '/' -%}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ post.url | absolute_url }}" />
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- if post.description %}
    <summary>{{ post.description | xml_escape }}</summary>
    {%- endif %}
    <content type="html">{{ post.content | replace: 'src="/', abs | replace: 'href="/', abs_href | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
